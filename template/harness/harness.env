# Harness settings. Read by harness/*.sh and passed to docker compose (--env-file).
COMPOSE_PROJECT_NAME={{PROJECT_NAME}}
ODOO_VERSION={{ODOO_VERSION}}
ODOO_IMAGE={{ODOO_IMAGE}}
POSTGRES_IMAGE={{POSTGRES_IMAGE}}
# Host path of the custom addons, relative to the repository root.
ADDONS_DIR={{ADDONS_DIR}}
# Comma-separated custom modules in scope (installed and tested by the harness).
MODULES={{MODULES}}
# Disposable database used for tests and e2e. Never point this at real data.
TEST_DB={{TEST_DB}}
ODOO_PORT={{ODOO_PORT}}
