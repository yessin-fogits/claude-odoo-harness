# Harness settings of this project. Read by the odoo-harness engine (installed with the plugin)
# and passed to docker compose (--env-file).
# Written by the init skill from what it detected in the project; edit when the project changes.
COMPOSE_PROJECT_NAME={{PROJECT_NAME}}
# Oldest odoo-harness engine this project accepts (odoo-harness where). An older engine refuses
# to run, so every teammate verifies with the same rules. The update skill raises it.
HARNESS_VERSION={{HARNESS_VERSION}}
ODOO_VERSION={{ODOO_VERSION}}
# Odoo image of the test runtime. When ODOO_DOCKERFILE is set, odoo-harness init builds the
# project's own Dockerfile into ODOO_IMAGE (same Python dependencies as production).
ODOO_IMAGE={{ODOO_IMAGE}}
ODOO_DOCKERFILE={{ODOO_DOCKERFILE}}
POSTGRES_IMAGE={{POSTGRES_IMAGE}}
# Addon folders, relative to the repository root, comma-separated.
# CUSTOM_ADDONS: the project's own modules, the only code the agent changes.
CUSTOM_ADDONS={{CUSTOM_ADDONS}}
# THIRD_PARTY_ADDONS: OCA and other vendors, read-only.
THIRD_PARTY_ADDONS={{THIRD_PARTY_ADDONS}}
# ENTERPRISE_DIR: Odoo Enterprise checkout, outside the repository (read-only); empty if unused.
ENTERPRISE_DIR={{ENTERPRISE_DIR}}
# Disposable database used for tests and e2e, with demo data. Never point this at real data.
TEST_DB={{TEST_DB}}
# Host port of the harness Odoo (not the dev stack's 8069).
ODOO_PORT={{ODOO_PORT}}
# Dev database mode, optional. Empty DEV_DB: the harness has its own PostgreSQL and every test
# runs on TEST_DB. Set: the harness uses the dev stack's PostgreSQL for TEST_DB too, and runs the
# e2e tests on DEV_DB, the developer's database: a neutralized copy of the client's data
# (odoo-bin neutralize), updated with -u, never created, dropped or reset.
DEV_DB=
# The dev PostgreSQL as the harness Odoo container reaches it: its compose service name on
# DEV_NETWORK (db), or host.docker.internal for a port published on this machine.
DEV_DB_HOST=
DEV_DB_PORT=5432
DEV_DB_USER=odoo
# Docker network of the dev stack (docker network ls), joined by the harness Odoo. Empty when
# DEV_DB_HOST is host.docker.internal, or when a service of the dev stack calls `odoo` by name
# (the harness Odoo has that name on the networks it joins).
DEV_NETWORK=
# Odoo data directory of the dev stack on this machine, with filestore/<DEV_DB>. For a docker
# volume, its Mountpoint in docker volume inspect <volume> (Docker Engine on Linux only; with
# Docker Desktop the dev stack needs a bind-mounted folder).
DEV_DATA_DIR=
# Secrets go in harness/dev.local.env (not versioned): DEV_DB_PASSWORD, and DEV_ODOO_LOGIN /
# DEV_ODOO_PASSWORD, the Odoo user the e2e tests log in with on DEV_DB.
# Git: task branches start from BASE_BRANCH; merge requests target it.
BASE_BRANCH={{BASE_BRANCH}}
GITLAB_URL={{GITLAB_URL}}
GITLAB_PROJECT={{GITLAB_PROJECT}}
# Paths the agent must never edit, comma-separated, relative to the repo root: deployment
# files are changed by a human. Third-party addons, ENTERPRISE_DIR, Odoo core with odoo-bin
# and Odoo S.A. modules are always protected.
PROTECTED_PATHS={{PROTECTED_PATHS}}
