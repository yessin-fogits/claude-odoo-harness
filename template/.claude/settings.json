{
  "permissions": {
    "allow": [
      "Bash(harness/init.sh:*)",
      "Bash(harness/verify.sh:*)",
      "Bash(harness/feature.py:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(feature_list.json)",
      "Write(feature_list.json)",
      "Edit(harness/evidence/**)",
      "Write(harness/evidence/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "extraKnownMarketplaces": {
    "odoo-harness": {
      "source": {
        "source": "github",
        "repo": "{{MARKETPLACE_REPO}}",
        "ref": "main"
      }
    }
  },
  "enabledPlugins": {
    "{{PLUGIN_ID}}": true
  }
}
