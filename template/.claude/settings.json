{
  "permissions": {
    "allow": [
      "Bash(odoo-harness init:*)",
      "Bash(odoo-harness verify:*)",
      "Bash(odoo-harness feature:*)",
      "Bash(odoo-harness guide:*)",
      "Bash(odoo-harness static:*)",
      "Bash(odoo-harness map:*)",
      "Bash(odoo-harness compose ps:*)",
      "Bash(odoo-harness compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(feature_list.json)",
      "Edit(harness/evidence/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "extraKnownMarketplaces": {
    "odoo-harness": {
      "source": {
        "source": "github",
        "repo": "{{MARKETPLACE_REPO}}",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "{{PLUGIN_ID}}": true
  }
}
